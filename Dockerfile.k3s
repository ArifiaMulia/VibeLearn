FROM node:20-alpine AS frontend-builder
WORKDIR /build
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app/api
COPY api/package*.json ./
RUN npm install --production
COPY api/ ./
COPY --from=frontend-builder /build/dist /app/dist
RUN mkdir -p /app/api/uploads/images /app/api/uploads/videos && chown -R 1000:1000 /app
EXPOSE 3000
CMD ["node", "index.js"]
